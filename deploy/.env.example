# Copia este fichero a ".env" (sin .example) EN EL NAS y rellénalo.
#
# El .env de verdad NO se sube a GitHub: lleva la contraseña de la base y un
# token. Está en .gitignore. Este .example sí, para saber qué hay que poner.

# --- GitHub ---------------------------------------------------------------

# Tu usuario de GitHub, en minúsculas.
GHCR_USER=tuusuario

# El nombre del repositorio, en minúsculas.
# De aquí salen las dos imágenes: <repo> y <repo>-api.
GHCR_REPO=braceros-app

# Token con permiso de lectura de paquetes (read:packages) y nada más.
# github.com > Settings > Developer settings > Personal access tokens >
# Tokens (classic) > Generate new token
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Base de datos --------------------------------------------------------

# Contraseña de Postgres. Invéntala larga; no la vas a escribir nunca a mano.
# Genérala en el NAS con:  openssl rand -base64 32
#
# OJO: solo se usa la primera vez, cuando se crea el volumen. Cambiarla
# después aquí NO la cambia en la base, y la API dejará de poder entrar.
DB_PASSWORD=cambiame

# --- Red ------------------------------------------------------------------

# Puerto del NAS donde se verá la app.
PUERTO=8087

# Cada cuántos segundos se comprueba si hay versión nueva en GitHub.
INTERVALO=300
