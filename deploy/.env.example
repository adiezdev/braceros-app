# Copia este fichero a ".env" (sin .example) EN EL NAS y rellénalo.
#
# El .env de verdad NO se sube a GitHub: lleva un token y está en .gitignore.
# Este .example sí, para que se sepa qué hay que rellenar.

# Tu usuario de GitHub, en minúsculas.
GHCR_USER=tuusuario

# El nombre del repositorio, en minúsculas.
GHCR_REPO=braceros-app

# Token de GitHub con permiso de lectura de paquetes (read:packages).
# Se crea en: github.com > Settings > Developer settings >
#             Personal access tokens > Tokens (classic) > Generate new token
# Marca SOLO la casilla read:packages. Nada más.
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Puerto del NAS donde se verá la app.
PUERTO=8087

# Cada cuántos segundos comprueba si hay versión nueva.
INTERVALO=300
